  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "requests": {},
        "exec": [
          "// Ambil base URL dari Collection Variable dulu, fallback ke Environment",
          "const baseUrl = pm.collectionVariables.get(\"url\") || pm.environment.get(\"url\");",
          "const tokenUrl = baseUrl + \"/api/v1/login\";",
          "",
          "// Ambil username & password dari Collection Variables",
          "const clientId = pm.collectionVariables.get(\"username\");",
          "const clientSecret = pm.collectionVariables.get(\"password\");",
          "",
          "// Siapkan request token",
          "const getTokenRequest = {",
          "  method: 'POST',",
          "  url: tokenUrl,",
          "  header: {",
          "    'Accept': '*/*',",
          "    'Content-Type': 'application/x-www-form-urlencoded',",
          "  },",
          "  body: {",
          "    mode: 'urlencoded',",
          "    urlencoded: [",
          "      { key: \"username\", value: clientId },",
          "      { key: \"password\", value: clientSecret }",
          "    ]",
          "  }",
          "};",
          "",
          "// Kirim request dan tangani responsenya",
          "pm.sendRequest(getTokenRequest, (err, response) => {",
          "  if (err) {",
          "    console.error(\"Request error:\", err);",
          "    return;",
          "  }",
          "",
          "  try {",
          "    const jsonResponse = response.json();",
          "    const newAccessToken = jsonResponse.token;",
          "",
          "    if (newAccessToken) {",
          "      pm.variables.set(\"access_token\", newAccessToken);",
          "      console.log(\"Access token set:\", newAccessToken);",
          "    } else {",
          "      console.warn(\"Token tidak ditemukan di response:\", jsonResponse);",
          "    }",
          "  } catch (e) {",
          "    console.error(\"Gagal parse JSON:\", e);",
          "    console.log(\"Response text:\", response.text());",
          "  }",
          "});"
        ]
      }
    },
